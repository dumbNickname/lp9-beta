# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Both variables below are PUBLIC by design: they ship in the browser
# bundle. The anon key is RLS-protected (see DESIGN.md §16e/§16g). They
# still live in `.env` (not source) per the secret-hygiene convention.
#
# No Supabase personal access token and no DB password are needed for the
# branch-driven migration flow (DESIGN.md §16e).

# Supabase project URL, e.g. https://your-project-ref.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable key (or legacy anon/public key). RLS-bounded;
# safe to ship in browser. Format: sb_publishable_... or eyJ...
VITE_SUPABASE_ANON_KEY=

# Build-time base path for asset URLs. Both environments build at "/".
# See app.config.ts.
BASE_PATH=/

# Shown product name; builds set "Endeary" / "Endeary beta". Empty = lp9.
VITE_APP_NAME=


# Web push (PRD-53): VAPID *public* key (public-safe). The private key
# goes ONLY into Supabase Edge Function secrets, never here.
VITE_VAPID_PUBLIC_KEY=

# Beta deploy (`pnpm deploy:beta`, PRD-57): put these in `.env.beta`
# (gitignored), not here. CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID,
# optional PROD_SUPABASE_URL / PROD_SUPABASE_KEY for the keep-alive.
